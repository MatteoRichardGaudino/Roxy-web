{
  "name": "roxy-webos-app",
  "version": "1.0.0",
  "description": "Roxy - OLED Optimized Streaming Player for LG webOS",
  "main": "index.html",
  "scripts": {
    "package": "ares-package . -o ./dist",
    "install-app": "ares-install ./dist/com.roxy.stream_1.0.0_all.ipk",
    "launch": "ares-launch com.roxy.stream",
    "inspect": "ares-inspect --app com.roxy.stream --open",
    "deploy": "npm run package && npm run install-app && npm run launch"
  },
  "keywords": [
    "webos",
    "lg-tv",
    "streaming",
    "oled",
    "tmdb"
  ],
  "author": "Roxy",
  "license": "MIT"
}
